{
  "name": "bj-gym-management-system",
  "version": "1.0.1",
  "description": "BJ Gym public website and management system",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {"start":"node server.js","dev":"node server.js","build:win":"pkg . --targets node18-win-x64 --output dist/BJ-Gym-Management-System.exe"},
  "dependencies": {"express":"^4.21.2"},
  "pkg": {
    "assets": [
      "public/**/*",
      "admin/**/*"
    ],
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  }
}
